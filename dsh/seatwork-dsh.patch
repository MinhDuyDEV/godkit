diff --git a/slp-room/plugin/test/runtime-dsh.test.ts b/slp-room/plugin/test/runtime-dsh.test.ts
new file mode 100644
index 0000000..c10837e
--- /dev/null
+++ b/slp-room/plugin/test/runtime-dsh.test.ts
@@ -0,0 +1,48 @@
+import { USER_DSH } from "./support/room";
+import assert from "node:assert/strict";
+import { existsSync, lstatSync, mkdirSync, rmSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { test } from "node:test";
+import type { DshRuntimePolicy, RuntimePolicy } from "../server/policy";
+import { envFor, ensureRuntime, runtimeDir } from "../server/runtimes";
+
+const seat = { harness: "dsh", role: "peer" } as const;
+const runtime = runtimeDir(seat);
+
+function policyWith(over: Partial<DshRuntimePolicy> = {}): RuntimePolicy {
+  const dsh: DshRuntimePolicy = {
+    shareFiles: [".credentials.yaml", ".anonymous-user-id"],
+    shareDirs: ["llm-deepseek"],
+    mcpServers: true,
+    ...over,
+  };
+  return { dsh } as RuntimePolicy;
+}
+
+/** Rebuilds from scratch, mirroring the way runtimes.test.ts makes each case run. */
+function build(policy: RuntimePolicy = policyWith()): void {
+  rmSync(runtime, { recursive: true, force: true });
+  ensureRuntime(seat, policy);
+}
+
+test("a dsh seat shares its credentials and keeps no user cordis patch", () => {
+  writeFileSync(join(USER_DSH, ".credentials.yaml"), "key: yes\n");
+  writeFileSync(join(USER_DSH, ".anonymous-user-id"), "uid\n");
+  writeFileSync(join(USER_DSH, "cordis.patch.yml"), "# the user's own plugins — a seat must not link this\n");
+  build();
+  assert.ok(existsSync(join(runtime, ".credentials.yaml")), "credentials are shared");
+  assert.ok(lstatSync(join(runtime, ".credentials.yaml")).isSymbolicLink(), "credentials are a symlink, not a copy");
+  assert.ok(existsSync(join(runtime, "sessions")), "the seat has its own sessions dir");
+  assert.ok(!existsSync(join(runtime, "cordis.patch.yml")), "no user plugin layer loads in a seat");
+});
+
+test("a dsh seat shares the model layer state and envFor points DSH_HOME at the runtime", () => {
+  mkdirSync(join(USER_DSH, "llm-deepseek"));
+  build();
+  assert.ok(existsSync(join(runtime, "llm-deepseek")), "model storage shared");
+  assert.deepEqual(envFor("dsh", runtime), { DSH_HOME: runtime });
+});
+
+test("a dsh seat without a dsh.runtime block is refused with the fix named", () => {
+  assert.throws(() => ensureRuntime(seat, {} as RuntimePolicy), /missing "dsh.runtime"|"dsh.runtime"/);
+});
\ No newline at end of file
